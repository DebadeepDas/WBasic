#Importing required modules for the program
import pyperclip as pyclip 
#This module helps in copying and pasting data easily
import os
#This module helps in creating and removing files easily
import time
#This module helps us to deal with execution time of the program, time related functions, etc.

#Introductory code blocks welcoming the user
print()
print('''"Welcome to WBasic"
A Basic Word Processor made using Python''')
print()
#Defining a function to accept the user desired option/feature of the program
def User_Input():
    ChosenOption = int(input("Which task would you like to perform?: "))
    return ChosenOption
#Giving the user the choice of what they want to do
def info():
    print('''Choose from the following features and type in the number specific to the task you want to perform''')
    print()
    print('''
    1 -->  Create a blank file and input data
    2 -->  Open an existing file to read and write data
    3 -->  Rename a file
    4 -->  Find and Replace words
    5 -->  Copy data from a file
    6 -->  Paste data into a file
    7 -->  Delete a character from a file
    8 -->  Delete a word from a file
    9 -->  Delete a line from a file
    10 --> Delete a file
    11 --> About and Credits
    12 --> Exit Program ''')
    print()

#Putting the entire program in a while loop
#in order to use the features multiple times
while True:
    info()

#Defining  variable to store the user's choice
    C = User_Input()

#Defining the functions to perform

#Create a blank file and input data
    if C == 1:
        print("Task Chosen: Create a blank file and input data")
        print()
        File_Loc = input("Where do you want to save your File?: ")
        FileName = input("Enter the desired name for your file: ")
        Data = input("Input the desired data which you want to write in your file: ")
        File = open(File_Loc+FileName+'.txt','w')
        File.write(Data)
        File.close()
        print()
        print("Your task has been succesfully completed")
        print()
#Open an existing file to read data
    elif C == 2:
        print("Task Chosen: Open an existing file to read data")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        File = open(File_Loc+FileName+'.txt','r+')
        print("Your file has been opened")
        print()
        Num_Chars = int(input("How many characters of the file do you want to read? "))
        R_Data = File.read(Num_Chars)
        W_Data = input("Input the data you want to add to this file (type n for no input): ")
        if W_Data in ['n','N']:
            break
        else:
            File.write(W_Data)
        print()
        u_choice = input("Do you want to display the read data? (type n for no output): ")
        if u_choice in ['n','N']:
            break
        else:
            print(R_Data)
        File.close()
        print()
        print("Your task has been succesfully completed")
        print()
#Rename a file
    elif C == 3:
        print("Task Chosen: Rename a file")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        NewName = input("Enter the new name for the file: ")
        source = File_Loc+FileName+'.txt'
        destination = File_Loc+NewName+'.txt'
        os.rename(source, destination)
        print()
        print("Your file, %s has been renamed successfully" %source)
        print()
#Find and Replace words
    elif C == 4:
        print("Task Chosen: Find and Replace")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        File = open(File_Loc+FileName+'.txt')
        Find = input("Which word do you want to find? ")
        Replace = input("What do you want to replace the word with: ")
        W_List = [] #creating an empty list to append into file after replacing the word
        count = 0 #creating a counter variable to store the number of times the word given by user appeared in file
        for Lines in File:
            if Find in Lines:
                Lines = Lines.replace(Find, Replace)
                count += 1
            W_List.append(Lines)
        File.close()
        File = open(File_Loc+FileName+'.txt', 'w')
        for L in W_List:
            File.write(L)
        File.close()
        print()
        print("Number of times",Find,"appeared in",File_Loc+FileName+'.txt',"is:", count)
        if count == 0:
            print("No changes occurred")
        else:
            print("Your word",Find,"has been replaced by",Replace,"successfully")
        print()
#Copy data from a file
    elif C == 5:
        print("Task Chosen: Copy data from a file")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        File = open(File_Loc+FileName+'.txt')
        Chars = int(input("How many characters do you want to copy?: "))
        Data = File.read(Chars)
        pyclip.copy(Data)
        File.close()
        print()
        print("Your data has been successfully copied to the clipboard")
        print()
#Paste data into a file
    elif C == 6:
        print("Task Chosen: Paste data into a file")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        File = open(File_Loc+FileName+'.txt', 'a')
        Data = pyclip.paste()
        File.write(Data)
        File.close()
        print()
        print(Data, "--> was successfully pasted into -->",File_Loc+FileName+'.txt')
        print()
#Delete a character from a file
    elif C == 7:
        print("Task Chosen: Delete a character from a file")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        File = open(File_Loc+FileName+'.txt')
        Char = input("Input the character which you want to delete: ")
        Data = File.read()
        Data_List = [] #creating an empty list to append all data after performing the required function
        count = 0 #creating a counter variable to store total occurrences of the character given by the user in the file
        List = Data.split()
        for character in Data:
            if character == Char:
                character = ''
                count += 1
            Data_List.append(character)
        File.close()
        File = open(File_Loc+FileName+'.txt', 'w')
        for char in Data_List:
            File.write(char)
        File.close()
        print()
        print("Number of times",Char,"appeared in",File_Loc+FileName+'.txt',"is:", count)
        if count == 0:
            print("No changes occurred")
        else:
            print("All occurrences of",Char,"have been removed from",File_Loc+FileName+'.txt',"successfully")
        print()
#Delete a word from a file
    elif C == 8:
        print("Task Chosen: Delete a word from a file")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        File = open(File_Loc+FileName+'.txt')
        Word = input("Input the word which you want to delete: ")
        W_List = [] #creating an empty list to append all data after performing the required function
        count = 0 #creating a counter variable to store total occurrences of the word given by the user in the file
        for L in File:
            if Word in L:
                L = L.replace(Word, '')
                count += 1
            W_List.append(L)
        File.close()
        File = open(File_Loc+FileName+'.txt', 'w')
        for L in W_List:
            File.write(L)
        File.close()
        print()
        print("Number of times",Word,"appeared in",File_Loc+FileName+'.txt',"is:", count)
        if count == 0:
            print("No changes occurred")
        else:
            print("All occurrences of",Word,"have been removed from",File_Loc+FileName+'.txt',"successfully")
        print()
#Delete a line from a file
    elif C == 9:
        print("Task Chosen: Delete a line from a file")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        File = open(File_Loc+FileName+'.txt')
        Line = input("Input the line which you want to delete: ")
        Data_List = [] #creating an empty list to append all data after performing the required function
        count = 0 #creating a counter variable to store total occurrences of the line given by the user in the file  
        Data = File.read()
        for Lines in Data:
            if Lines == Line:
                Lines = ''
                count += 1
            Data_List.append(Lines)
        File.close()
        File = open(File_Loc+FileName+'.txt', 'w')
        for L in Data_List:
            File.write(L)
        File.close()
        print()
        print("Number of times",Line,"appeared in",File_Loc+FileName+'.txt',"is:", count)
        if count == 0:
            print("No changes occurred")
        else:
            print("All occurrences of:",Line,"--> have been removed from -->",File_Loc+FileName+'.txt',"successfully")
        print()
#Delete a file
    elif C == 10:
        print("Task Chosen: Delete a file")
        print()
        File_Loc = input("Where is your File? (Give entire file path): ")
        FileName = input("Enter the name of the file which you want to open: ")
        File = File_Loc+FileName+'.txt'
        Flag = 0 #creating a flag to print prompt when exception: user is trying to delete a non-existent file in that location
        try:
            os.remove(File)
        except:
            print()
            print("File does not exit")
            Flag = 1
        print()
        if Flag == 0:
            print("Your",File,"has been successfully deleted")
        else:
            print("No changes took place")
        print()
#About and Credits
    elif C == 11:
        print()
        print("About and Credits")
        print()
        print('''This program was created by Debadeep Das of Class 12, Section A of Kendriya Vidyalaya Khanapara.
        
